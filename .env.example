# Copy to .env and fill in. Never commit .env.

# Must be exactly the SECRET in Trade Empire's ServerStorage.SiteWalletConfig.
GAME_WEBHOOK_SECRET=

PORT=8080
# Where the SQLite database lives. Back this file up.
DB_PATH=./tradeblacket.db
# Keep true in production (site served over https). Set false only for local http testing.
COOKIE_SECURE=true

# Studio games (LuckyStreak). Leave empty until LuckyStreak sends your credentials; the Slots page
# shows TradeBlacket's own slots until all four of the first four are set.
LUCKYSTREAK_API_URL=
LUCKYSTREAK_OPERATOR_ID=
LUCKYSTREAK_HAWK_ID=
LUCKYSTREAK_HAWK_KEY=
LUCKYSTREAK_CURRENCY=RDX
LUCKYSTREAK_ALLOW_IPS=
LUCKYSTREAK_LAUNCH_PATH=/game/launch
LUCKYSTREAK_GAMES_PATH=/games
PUBLIC_URL=https://tradeblacketv2-production.up.railway.app/#slots

# Roblox user ids that can manage the slots waitlist and make access codes (comma separated).
ADMIN_ROBLOX_IDS=496295513
# Whole-site waitlist: on (invite-only, default) or off (open to everyone).
SITE_WAITLIST=on
# Bonus Rodux paid per referred friend who gets in.
REFERRAL_REWARD=450
# Robux per US dollar for gift card values (Roblox sells 400 Robux for $4.99).
ROBUX_PER_USD=80
